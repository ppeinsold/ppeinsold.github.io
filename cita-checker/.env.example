# --- who is asking for the appointment -----------------------------------
ICP_NIE=Z5053331Y
ICP_NOMBRE=Philip Peinsold

# --- what to watch --------------------------------------------------------
ICP_PROVINCIA=Barcelona
ICP_TRAMITE=POLICIA - CERTIFICADO DE REGISTRO DE CIUDADANO DE LA UE
# Optional: pin the oficinas instead of auto-detecting them every 24h.
# Substring match, comma separated. Run `npm run offices` to see the list.
#ICP_OFICINAS=

# --- when to look ---------------------------------------------------------
# Local times in ICP_TZ. The scheduler fires every few minutes all day;
# the script exits immediately outside these windows.
ICP_WINDOWS=07:45-08:30,13:00-13:10,17:00-17:10,20:30-20:40
ICP_TZ=Europe/Madrid

# --- email ----------------------------------------------------------------
MAIL_TO=philippeinsold@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=philippeinsold@gmail.com
# Gmail app password (16 chars, https://myaccount.google.com/apppasswords).
# NOT your normal Google password.
SMTP_PASS=
#MAIL_FROM=

# --- phone push (optional but recommended - email is slow at 07:46) --------
# ntfy: free, no account. Install the ntfy iOS app, subscribe to a topic name
# only you know, and put the same name here.
#NTFY_TOPIC=cita-bcn-<something-random>
#NTFY_SERVER=https://ntfy.sh
#NTFY_TOKEN=

# Pushover: 5 EUR once, more reliable delivery, can override silent mode.
#PUSHOVER_TOKEN=
#PUSHOVER_USER=

# --- tuning ---------------------------------------------------------------
ICP_COOLDOWN_MIN=45          # don't re-email about the same oficina this often
ICP_DELAY_MS=4000            # pause between oficinas, be polite to the server
ICP_OFFICE_CACHE_HOURS=24    # how long to trust the cached oficina list
ICP_ERROR_STREAK_ALERT=6     # email me if this many runs in a row fail
ICP_HEADED=0                 # 1 = watch the browser work
